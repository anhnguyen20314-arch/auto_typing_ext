{
  "manifest_version": 3,
  "name": "Auto Typer",
  "version": "0.1.0",
  "description": "Types your text into the focused field with human-like speed, pauses and self-corrected typos. Optional AI rewrite.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Auto Typer"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["engine.js", "content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-typing": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Start typing into the focused field (or stop if already typing)"
    },
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Pause or resume typing"
    }
  }
}
